# Exact public browser origin. Paths are normalized away; wildcards are rejected.
# Bare hostnames (e.g. doligrid.com) are auto-normalized to https://host.
LANDING_PUBLIC_URL=https://doligrid.com

# Optional comma-separated exact origins for aliases/previews (www, previews, local).
# Prefer full origins with scheme. Bare hosts are auto-normalized to https://host.
# Local development is NOT implicit — list both (browsers treat them as different Origins):
#   http://localhost:3000 and http://127.0.0.1:3000
ALLOWED_LANDING_ORIGINS=https://www.doligrid.com,http://localhost:3000,http://127.0.0.1:3000

# Core origin or a URL ending in /api/v1.
CORE_API_URL=https://manager.frametoy.online/api/v1
PRODUCT_SLUG=doligrid

# Server-only. Use the same value configured in Manager Admin → Settings.
# Never prefix this variable with NEXT_PUBLIC_.
PLATFORM_API_KEY=<server-only-platform-api-key>

# Paddle.js overlay checkout (client-side token from Paddle → Developer tools).
# Use sandbox token + NEXT_PUBLIC_PADDLE_ENV=sandbox while testing.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENV=sandbox

# Client Portal base URL (Manager FRONTEND_URL). Returned by /api/wire after proof
# submit so the browser can redirect to /login?wire=pending.
# If unset, the landing BFF falls back to the origin of CORE_API_URL.
# Align with Manager FRONTEND_URL, e.g. https://manager.frametoy.online
PORTAL_URL=https://manager.frametoy.online
NEXT_PUBLIC_PORTAL_URL=https://manager.frametoy.online

# Wire transfer is Morocco-only (ISO country MA from CDN geo headers:
# x-vercel-ip-country, cf-ipcountry, x-country-code). Locally there is usually
# no geo header — set this to MA to test virement, or leave unset to hide it.
# WIRE_FORCE_COUNTRY=MA
